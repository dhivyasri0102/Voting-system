# Environment Variables for National E-Voting System

PORT=3000
NODE_ENV=development

# Database & Cache (Configured via Docker Compose for local development)
DATABASE_URL=postgresql://election_admin:SecureElectionPass2026!@localhost:5432/evoting_db
REDIS_URL=redis://:RedisSecurePass2026!@localhost:6379/0

# JWT & Admin Security (Automatically generated at runtime if left empty)
JWT_SECRET=
ADMIN_MFA_SECRET=

# UIDAI / Aadhaar Integration Configuration
# By default set to 'unconfigured'. Do NOT invent AUA credentials, license keys, or certificates.
UIDAI_ENVIRONMENT=unconfigured
UIDAI_ENABLE=false
UIDAI_AUTH_URL=
UIDAI_OTP_URL=
UIDAI_KYC_URL=
UIDAI_AUA_CODE=
UIDAI_SUB_AUA_CODE=
UIDAI_LICENSE_KEY=
UIDAI_CERTIFICATE_PATH=
UIDAI_PRIVATE_KEY_PATH=
UIDAI_PUBLIC_KEY_PATH=
UIDAI_TIMEOUT_SECONDS=10

# Electoral Roll Service
# Set to 'unconfigured' until an authorized endpoint is provided. Do NOT invent an API URL or API key.
ELECTORAL_ROLL_ENVIRONMENT=unconfigured
ELECTORAL_ROLL_API_URL=
ELECTORAL_ROLL_API_KEY=

# Hyperledger Fabric Local Configuration (Populated automatically by FabricNetworkManager)
FABRIC_CHANNEL=election-channel
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_MSPID=ElectionAuthorityMSP
FABRIC_CERT_PATH=blockchain/crypto-material/peerOrganizations/election-authority.gov/peers/peer0.election-authority.gov/tls/server.crt
FABRIC_KEY_PATH=blockchain/crypto-material/peerOrganizations/election-authority.gov/peers/peer0.election-authority.gov/tls/server.key
FABRIC_CA_CERT=blockchain/crypto-material/peerOrganizations/election-authority.gov/ca/ca.election-authority.gov-cert.pem
FABRIC_ORDERER_ENDPOINT=localhost:7050
FABRIC_TLS_ENABLED=true
